# 클라우드 상시 서버(CPU 서버) 설정 틀. scripts/cloud/setup.sh가 처음 한 번 .env로 복사한다. .env는 커밋하지 않는다.
# mode·크기는 직접 고치지 말고 scripts/cloud/mode.sh, scripts/cloud/size.sh로 바꾼다.

# ---- 지금 상태 (mode.sh가 바꾼다) ----
LLM_MODE=mock
COMPOSE_PROFILES=mock-workers
WORKER_URLS=worker-1=http://worker-1:8091,worker-2=http://worker-2:8092
BROKER_CONCURRENCY_CAP=8
MODEL_ACTIVE_STAGE=U0

# ---- mock 모드 값 ----
# 동시 실행 상한 = (mock worker 2대 - 1) × 워커당 슬롯 8 (R3: N+1)
MOCK_CONCURRENCY_CAP=8

# ---- real 모드 값 (GPU 서버를 붙일 때 채운다) ----
# GPU 서버 주소: 워커ID=http://GPU서버프라이빗IP:포트 (쉼표 구분). 프라이빗 IP는 중지·시작해도 바뀌지 않는다
REAL_WORKER_URLS=
# 동시 실행 상한. QAS 측정: 4대분 = 4 × 워커당 슬롯(50) = 200 (GPU 5대일 때). GPU 2대면 100
REAL_CONCURRENCY_CAP=100
# vLLM을 FP8 + KV FP8로 띄우므로 FP8
REAL_ACTIVE_STAGE=FP8

# ---- 브라우저 출처 ----
# 공인 IP가 켤 때마다 바뀌므로 8140 포트의 모든 출처를 허용한다. 접근은 보안 그룹(팀원 IP)으로 막는다
CORS_ORIGINS=http://localhost:8140,http://*:8140

# ---- 서버 크기 (size.sh가 바꾼다) ----
# light: t3.medium(4GB) / measure: m7i.2xlarge(32GB, QAS 측정 날)
SERVER_SIZE=light
MEM_SMALL=256m
MEM_MEDIUM=320m
MEM_LARGE=448m

# ---- 밤 자동 중지 ----
# 1이면 매일 00:00(한국 시간)에 서버를 중지한다. 기본은 꺼짐(밤늦게 작업하는 일이 많음).
# 켜고 끄는 것은 setup.sh를 다시 실행해야 반영된다
AUTO_STOP=0
