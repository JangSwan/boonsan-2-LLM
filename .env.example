# real 모드 설정 틀. 서버에서 `cp .env.example .env` 후 값을 채운다. .env는 커밋하지 않는다(.gitignore).
# 주소는 모두 EC2 "프라이빗 IPv4 주소"를 쓴다 (같은 VPC 안에서만 통신).

# ---- GPU 서버 (docker-compose.real-gpu.yml) ----
# Hugging Face Read 토큰 (Llama 3.1 라이선스 승인된 계정)
HF_TOKEN=
# 이 GPU 서버의 워커 ID와 포트. 1번 서버: worker-1 / 8091, 2번 서버: worker-2 / 8092
INSTANCE_ID=worker-1
SERVER_PORT=8091
# CPU 서버의 프라이빗 IP
CONTROL_IP=

# 모델과 엔진 설정
VLLM_MODEL=meta-llama/Llama-3.1-8B-Instruct
VLLM_MAX_MODEL_LEN=8192
VLLM_GPU_MEMORY_UTILIZATION=0.90
# U1 FP8 단계 + 비평 수용(KV 캐시 FP8). BF16(U0)으로 재려면 비워 둔다
VLLM_EXTRA_ARGS=--quantization fp8 --kv-cache-dtype fp8
VLLM_MAX_TOKENS=256

# 1주차 측정으로 정하는 값 (README "슬롯과 상한 정하기")
# 워커당 슬롯 = vLLM 로그 "Maximum concurrency for N tokens per request"를 보고 정한다 (vLLM max-num-seqs와 같음)
WORKER_MAX_SLOTS=50
# B 상한 = vLLM max-num-batched-tokens
WORKER_B_MAX=2048
# 요청당 KV(GB) = 단계의 kv-gb-per-gpu(model-manager 설정) ÷ 워커당 슬롯. 슬롯보다 KV 기준이 먼저 막히지 않게 맞춘다
WORKER_KV_GB_PER_REQUEST=0.2
# 크레딧의 미시작 Prefill 토큰 상한. 이 값 이상 쌓이면 워커가 새 작업을 가져가지 않는다(첫 토큰 지연을 묶어 두려는 T3 장치).
# mock 기본값 16000은 긴 입력(약 4,000토큰) 4건이면 닿아서, 실측(L4 2대, 동시 80건)에서 요청 100%가 broker 대기열에서 기다렸다
# (p95 4.9초 FAIL). 64000으로 올리자 같은 조건에서 p95 1.2초(PASS). 실제 Prefill 속도에 맞춘 값이다 (docs/troubleshooting.md R7)
WORKER_MAX_UNSTARTED_TOKENS=64000

# ---- CPU 서버 (docker-compose.yml + docker-compose.real-control.yml) ----
# model-manager 처음 활성 단계. vLLM을 FP8로 띄우므로 FP8 (kv-gb-per-gpu 10.0이 실측 10.07GiB와 맞음)
MODEL_ACTIVE_STAGE=FP8
# 워커 주소: 워커ID=http://GPU서버프라이빗IP:포트 (쉼표로 구분)
WORKER_URLS=worker-1=http://10.0.0.11:8091,worker-2=http://10.0.0.12:8092
# 동시 실행 상한. QAS1·QAS2 측정: GPU 대수 × 워커당 슬롯 (2대 = 2대분, 보고서 4대분을 절반으로 환산)
# N+1 장애 시연(R3): (GPU 대수 - 1) × 워커당 슬롯 (2대 = 1대분)
BROKER_CONCURRENCY_CAP=100
